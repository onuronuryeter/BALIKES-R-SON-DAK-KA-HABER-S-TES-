# ===================================
# BALIKESİR SON DAKİKA HABER
# .env.example
# ===================================

# --- Uygulama ---
APP_ENV=development
DEBUG=True
APP_NAME=Balıkesir Son Dakika Haber
APP_VERSION=1.0.0

# --- Güvenlik ---
SECRET_KEY=generate_a_very_strong_random_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# --- Veritabanı ---
DATABASE_URL=sqlite+aiosqlite:///./data/database.sqlite3

# --- Site Bilgileri ---
SITE_NAME=Balıkesir Son Dakika Haber
SITE_URL=http://127.0.0.1:8000
SITE_DESCRIPTION=Balıkesir ve ilçelerinden son dakika haberleri

# --- Admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@balikesirsondakikahaber.com

# --- AI Servisi ---
AI_PROVIDER=nvidia

# --- NVIDIA NEMOTRON ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=16384
NVIDIA_REASONING_EFFORT=medium
NVIDIA_REASONING_BUDGET=16384
NVIDIA_STREAM=true
NVIDIA_TIMEOUT=180

# --- RSS & Haber Toplama ---
RSS_FETCH_INTERVAL_MINUTES=15
MAX_ARTICLES_PER_SOURCE=50

# --- Dosya Yükleme ---
UPLOAD_DIR=./data/media
MAX_UPLOAD_SIZE_MB=10

# --- CORS ---
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
